<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>migurdex</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <Target Name="CopySqliteNativeToApi" AfterTargets="Publish">
        <ItemGroup>
            <SqliteNative Include="$(PublishDir)libe_sqlite3.so" Condition="Exists('$(PublishDir)libe_sqlite3.so')" />
            <SqliteNative Include="$(PublishDir)e_sqlite3.dll" Condition="Exists('$(PublishDir)e_sqlite3.dll')" />
            <SqliteNative Include="$(PublishDir)libe_sqlite3.dylib" Condition="Exists('$(PublishDir)libe_sqlite3.dylib')" />
        </ItemGroup>
        <Copy SourceFiles="@(SqliteNative)" DestinationFolder="$(PublishDir)../api" Condition="'@(SqliteNative)' != ''" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <TrimmerRootAssembly Include="migurdex"/>
        <TrimmerRootAssembly Include="Migurdex.Core"/>
        <TrimmerRootAssembly Include="Migurdex.Shared"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.49.1"/>
        <PackageReference Include="Spectre.Console.Cli" Version="0.49.1"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*-*"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.*-*"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Migurdex.Shared\Migurdex.Shared.csproj"/>
        <ProjectReference Include="..\Migurdex.Core\Migurdex.Core.csproj"/>
    </ItemGroup>

</Project>
